PORT=3000
JWT_SECRET=replace-with-a-long-random-string

# Postgres (local docker-compose default shown). Hosted DBs (Neon/Supabase/Render): paste their URL and set PGSSL=true
DATABASE_URL=postgres://game:game@localhost:5432/game
PGSSL=false

# Gmail that SENDS the codes. Use a 16-char App Password (needs 2-Step Verification on).
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
# 465 (default) or 587 if your network blocks 465
SMTP_PORT=465

# Local testing: if Gmail fails, print the code in the server console instead of erroring.
# Set to false in production!
DEV_FALLBACK=true

CORS_ORIGIN=*
